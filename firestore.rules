// Firestore security rules with basic validation

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isDeskAdmin() {
      return request.auth != null
        && request.auth.uid == 'bsoHTJvKDiOr3qzvmL1EIHdnsji1';
    }

    function isReservedBotName() {
      return request.resource.data.name is string
        && request.resource.data.name.matches('(?i)^[\\s._\\-–—]*((wiki[\\s._\\-–—]*bot)|(ו+יקי[\\s._\\-–—]*בוט))[\\s._\\-–—]*$');
    }

    // Email/password accounts must have confirmed their address. Google accounts are verified by Google.
    function isVerified() {
      return request.auth != null
        && (request.auth.token.email_verified == true
          || request.auth.token.firebase.sign_in_provider == 'google.com');
    }

    function isReservedNickname(name) {
      return name.matches('(?i)^[\\s._\\-–—]*((wiki[\\s._\\-–—]*bot)|(ו+יקי[\\s._\\-–—]*בוט))[\\s._\\-–—]*$');
    }

    // One document per lower-cased nickname. Its existence is what makes a nickname unique.
    match /nicknames/{key} {
      allow get: if true;
      allow list: if false;
      allow create: if isVerified()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 24
        && request.resource.data.name.lower() == key
        && !isReservedNickname(request.resource.data.name)
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.key == key;
      allow update: if false;
      // Released only when the owner moves to a different nickname in the same write.
      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.key != key;
    }

    // Each player's profile. The nickname must be reserved for the same player.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if isVerified()
        && request.auth.uid == uid
        && request.resource.data.nickname is string
        && request.resource.data.key is string
        && request.resource.data.nickname.lower() == request.resource.data.key
        && getAfter(/databases/$(database)/documents/nicknames/$(request.resource.data.key)).data.uid == uid;
      allow delete: if false;
    }

    // Allow read access to 'daily' collection
    match /daily/{document=**} {
      allow read: if true;
    }
    // Allow read access to 'scores' collection
    match /scores/{documentId} {
      allow read: if true;
      // Anyone may save a score. The official bot name is reserved for that bot.
      // Players must be verified and post under their own uid. The daily bot keeps its own path.
      allow create: if (request.resource.data.uid == 'wiki-reasoner')
        || (!isReservedBotName()
          && isVerified()
          && request.resource.data.uid == request.auth.uid);
      // Scores stay fixed. The owner may attach the shortest path once, after it is found.
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fastestPath'])
        && !resource.data.keys().hasAny(['fastestPath'])
        && request.resource.data.fastestPath is list
        && request.resource.data.fastestPath.size() <= 25;
      allow delete: if false;
    }
    // The next five daily pairs, and the pool of articles that already went live.
    // Only the desk owner can read or change them.
    match /lotteryQueue/{id} {
      allow read, write: if isDeskAdmin();
    }
    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
