# Copy to web/.env for local runs, or set these in your Netlify site's environment variables.
# None of them is needed to build. Without one, the feature it powers stays off.

# --- Netlify functions (scope: functions) ---
# Gemini key for the AI bot's moves. Also a GitHub Actions secret (see below).
GEMINI_API_KEY=your-gemini-api-key-here
# Resend key and recipient for the "name to review" email.
RESEND_API_KEY=your-resend-api-key-here
NAME_ALERT_TO=your-email-here

# --- Test site only (scope: builds). Leave all of these unset on production. ---
# Turns on the test branding and the test-only tools.
WIKIGAME_ENV=test
WIKIGAME_TEST_ADMIN_UID=your-test-admin-uid-here
WIKIGAME_TEST_DESK_PATH=your-secret-path-here
# Code for the test site's jump-to-goal prompt.
WIKIGAME_SECRET_CODE=your-secret-code-here

# --- GitHub Actions secrets (repo Settings > Secrets and variables > Actions), not Netlify ---
# GOOGLE_SERVICE_ACCOUNT_JSON: a Firebase service account key (JSON), for rules deploys and the daily lottery.
# GEMINI_API_KEY: same as above, for the bot runs in the daily lottery.
